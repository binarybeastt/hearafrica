 "lines": {
  "Èdè Yorùbá|11fdh6n": {
   "text": "Bẹ́ẹ̀ ni. Eléyìí jẹ́ five hundred, paint kan jẹ́ four thousand, agbọ̀n kan jẹ́ sixty thousand.",
   "voice": "Kore",
   "slow": false,
   "seconds": 7.04
  },
  "Èdè Yorùbá|11oe9hq": {
   "text": "Ẹ jọ̀ọ́ ma, báwo lẹ ṣe lé ata yín?",
   "voice": "Kore",
   "slow": false,
   "seconds": 3
  },
  "Èdè Yorùbá|11oe9hq|slow": {
   "text": "Ẹ jọ̀ọ́ ma, báwo lẹ ṣe lé ata yín?",
   "voice": "Kore",
   "slow": true,
   "seconds": 6.32
  },
  "Èdè Yorùbá|1207y05": {
   "text": "Paint kan jẹ́ three thousand.",
   "voice": "Kore",
   "slow": false,
   "seconds": 2.24
  },
  "Èdè Yorùbá|15feq2x": {
   "text": "Mo ti dì í. O ṣeun.",
   "voice": "Kore",
   "slow": false,
   "seconds": 2.16
  },
  "Èdè Yorùbá|15t7i1s": {
   "text": "Ẹ jọ̀ọ́ ma, ẹ tún un sọ.",
   "voice": "Kore",
   "slow": false,
   "seconds": 2.16
  },
  "Èdè Yorùbá|15t7i1s|slow": {
   "text": "Ẹ jọ̀ọ́ ma, ẹ tún un sọ.",
   "voice": "Kore",
   "slow": true,
   "seconds": 5.32
  },
  "Èdè Yorùbá|17d0n0r": {
   "text": "Ó dáa, mo ti fi jàra sí i. Máa bọ̀ o.",
   "voice": "Kore",
   "slow": false,
   "seconds": 4.16
  },
  "Èdè Yorùbá|1a10zmo": {
   "text": "Mm. Káalẹ́.",
   "voice": "Kore",
   "slow": false,
   "seconds": 1.68
  },
  "Èdè Yorùbá|1f9s0w9": {
   "text": "Mm. Káàárọ̀.",
   "voice": "Kore",
   "slow": false,
   "seconds": 1.44
  },
  "Èdè Yorùbá|1ft6cf3": {
   "text": "Yẹn ni! Káàsán ọmọ mi. Ṣé dáadáa ni?",
   "voice": "Kore",
   "slow": false,
   "seconds": 3.28
  },
  "Èdè Yorùbá|1iqckmb": {
   "text": "Eléyìí, five hundred. Paint kan, four thousand. Agbọ̀n kan, sixty thousand.",
   "voice": "Kore",
   "slow": false,
   "seconds": 7.8
  },
  "Èdè Yorùbá|1iqckmb|slow": {
   "text": "Eléyìí, five hundred. Paint kan, four thousand. Agbọ̀n kan, sixty thousand.",
   "voice": "Kore",
   "slow": true,
   "seconds": 12.68
  },
  "Èdè Yorùbá|1j86e96": {
   "text": "Yẹn ni! Káalẹ́ ọmọ mi. Ṣé dáadáa ni?",
   "voice": "Kore",
   "slow": false,
   "seconds": 3.96
  },
  "Èdè Yorùbá|1oxlt8a": {
   "text": "Dáadáa ni ma. Ẹ kú ọjà o!",
   "voice": "Kore",
   "slow": false,
   "seconds": 3.16
